{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/status-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pip install -q /tmp/claude-0/*/sherpa_onnx-*.whl)",
      "Bash(curl -sL -o * https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/*)"
    ]
  }
}
